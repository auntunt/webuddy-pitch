[Unit]
Description=Webuddy native service
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/webuddy/app
EnvironmentFile=/opt/webuddy/config/webuddy.env
Environment=HOME=/opt/webuddy/home
Environment=CODEX_HOME=/opt/webuddy/codex
Environment=TZ=UTC
Environment=PYTHONUNBUFFERED=1
Environment=PATH=/opt/webuddy/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/opt/webuddy/venv/bin/python3 -m tmh serve --host 192.168.112.1 --port 8791 --data /opt/webuddy/data
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
KillMode=control-group
NoNewPrivileges=yes

[Install]
WantedBy=default.target
