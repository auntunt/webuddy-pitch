# 私有环境文件示例。复制为 config/webuddy.env，设置真实值后 chmod 600。
# 由 systemd EnvironmentFile、服务管理器或之后的容器 env_file 加载；应用不自动读取 .env。
TMH_DATA_DIR=/var/lib/webuddy
TMH_HOST=127.0.0.1
TMH_PORT=8790
TMH_BRAND=webuddy
TMH_PUBLIC_URL=http://localhost:8790
# 设置直接值或 TMH_TOKEN_FILE 之一，不要同时设置。
TMH_TOKEN=
# TMH_TOKEN_FILE=/run/secrets/webuddy-token
# 可选飞书配置，沿用现有租户与成员权限。
# TMH_FEISHU_APP_ID=
# TMH_FEISHU_APP_SECRET_FILE=/run/secrets/feishu-app-secret
# TMH_FEISHU_TENANT_KEY=
