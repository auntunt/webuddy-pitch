    {
      "name": "webuddy_ticket_create",
      "title": null,
      "description": "在现有项目创建工单，保留需求原文并暂停自动执行。不会自动调用模型。请求编号用于断线重试。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "project": {
            "type": "string",
            "description": "项目代号",
            "pattern": "^[A-Za-z0-9]+$"
          },
          "title": {
            "type": "string",
            "description": "需求标题",
            "minLength": 1,
            "maxLength": 200
          },
          "body": {
            "type": "string",
            "description": "完整需求与验收标准",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "description": "工单类型",
            "enum": [
              "bug",
              "feature",
              "change",
              "question",
              "ops"
            ],
            "default": "feature"
          },
          "request_id": {
            "type": "string",
            "description": "持久请求编号。同一意图重试必须复用编号；改变内容必须使用新编号。",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "required": [
          "project",
          "title",
          "body",
          "request_id"
        ],
        "additionalProperties": false
      },
