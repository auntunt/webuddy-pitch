    {
      "name": "webuddy_message_send",
      "title": null,
      "description": "把问题、进度、交接或结果写入工单沟通记录；收件人通过 messages_list 拉取，不会唤醒或运行另一个助手。全文保留，不代表人工批准。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "ticket": {
            "type": "string",
            "description": "工单编号，例如 BOOTV2-1",
            "pattern": "^[A-Za-z0-9]+-[1-9][0-9]*$"
          },
          "body": {
            "type": "string",
            "description": "完整消息正文",
            "minLength": 1
          },
          "to_agent": {
            "type": "string",
            "description": "连接名，例如 codex 或 cursor；* 表示所有参与者",
            "pattern": "^(\\*|[A-Za-z0-9_-]{1,32})$",
            "default": "*"
          },
          "kind": {
            "type": "string",
            "description": "消息类型",
            "enum": [
              "note",
              "question",
              "handoff",
              "result"
            ],
            "default": "note"
          },
          "reply_to": {
            "type": "integer",
            "description": "同一工单的原消息事件编号",
            "minimum": 1,
            "maximum": 9223372036854775807
          },
          "request_id": {
            "type": "string",
            "description": "持久请求编号。同一意图重试必须复用编号；改变内容必须使用新编号。",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "required": [
          "ticket",
          "body",
          "request_id"
        ],
        "additionalProperties": false
      },
