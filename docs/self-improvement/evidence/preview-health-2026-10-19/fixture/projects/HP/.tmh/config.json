{
  "version": 1,
  "project": {
    "name": "预览健康恢复夹具",
    "description": "隔离的 HTTP/SQLite 验收场景，不计新业务实现或人工签收。"
  },
  "source": {
    "db": "unknown",
    "appserver": "unknown",
    "os": "unknown",
    "arch": "x86_64"
  },
  "target": {
    "db": "unknown",
    "appserver": "unknown",
    "os": "kylin",
    "arch": "unknown",
    "crypto": "none",
    "mq": "unknown",
    "cache": "unknown",
    "browser": "chromium",
    "jdk": "unknown"
  },
  "commands": {
    "build": "'/Users/auntlee/Desktop/workspace/运维智能体/tob-maintenance-harness/data/agent-venv314/bin/python' -m py_compile app.py",
    "test": "'/Users/auntlee/Desktop/workspace/运维智能体/tob-maintenance-harness/data/agent-venv314/bin/python' -m unittest discover -s tests -v",
    "extra_checks": []
  },
  "protected": [
    "**/src/test/**",
    "**/*Test.java",
    "**/*Tests.java",
    "**/*Tests.cs",
    "**/*.Tests/**",
