    "kb": "db-dialects.md#函数对照",
    "effort": "S"
  },
  {
    "id": "DB-ORA-003",
    "category": "database",
    "title": "PL/SQL 存储过程/包/触发器",
    "severity": "high",
    "files": ["*.sql", "*.pkb", "*.pks", "*.prc", "*.trg", "*.xml", "*.java", "*.cs"],
    "patterns": ["CREATE\\s+(OR\\s+REPLACE\\s+)?(PACKAGE|PROCEDURE|FUNCTION|TRIGGER)\\b", "\\{\\s*call\\s+", "statementType\\s*=\\s*\"CALLABLE\"", "\\bDBMS_\\w+\\.", "\\bUTL_\\w+\\.", "CommandType\\.StoredProcedure"],
    "flags": "i",
    "requires": ["target.db not in oracle"],
