    "id": "MW-AS-001",
    "category": "middleware",
    "title": "WebLogic 专有部署描述符或 API",
    "severity": "high",
    "files": ["*.xml", "*.java", "*.properties"],
    "path_patterns": ["weblogic(-application)?\\.xml$"],
    "patterns": ["\\bweblogic\\.", "<weblogic-web-app", "prefer-web-inf-classes", "t3://"],
    "requires": ["target.appserver not in weblogic"],
    "advice": "改为目标中间件描述符（东方通 TongWeb 的 tongweb-web.xml、金蝶 Apusic、宝兰德 BES 各有对应文件）。类加载优先级（prefer-web-inf-classes）、JNDI 数据源名、会话与集群配置要逐项映射；t3 协议的 EJB/JMS 远程调用需改为 HTTP/MQ。",
    "kb": "middleware.md#应用服务器",
    "effort": "M"
  },
  {
    "id": "MW-AS-002",
    "category": "middleware",
    "title": "WebSphere / JBoss 专有描述符或 API",
    "severity": "high",
    "files": ["*.xml", "*.xmi", "*.java"],
    "path_patterns": ["ibm-web-(bnd|ext)\\.(xml|xmi)$", "jboss-(web|deployment-structure)\\.xml$"],
