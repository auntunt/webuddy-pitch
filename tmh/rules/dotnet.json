[
  {
    "id": "NET-FW-001",
    "category": "dotnet",
    "title": ".NET Framework 项目（只能在 Windows 运行，需迁移到 .NET 8+ 才能上麒麟/统信）",
    "severity": "high",
    "files": ["*.csproj", "*.vbproj", "*.config", "packages.config"],
    "patterns": ["<TargetFrameworkVersion>v[1-4]\\.", "<TargetFramework>net(2|3|4)\\d+</TargetFramework>", "<TargetFrameworks>[^<]*net4\\d", "targetFramework=\"4\\.", "<supportedRuntime\\s+version=\"v[24]"],
    "requires": ["target.os not in windows"],
    "advice": "按项目依赖顺序从底层类库开始迁：先转 SDK 风格 csproj，类库改多目标 netstandard2.0/net8.0，再迁 Web/服务宿主。迁移顺序与阻塞项见 dotnet.md。",
    "kb": "dotnet.md#迁移路线",
    "effort": "L"
  },
  {
    "id": "NET-WEB-001",
    "category": "dotnet",
    "title": "System.Web / ASP.NET WebForms / HttpContext.Current",
    "severity": "high",
    "files": ["*.cs", "*.vb", "*.aspx", "*.ascx", "*.asax", "*.master", "*.config"],
    "path_patterns": ["\\.(aspx|ascx|master|ashx|asmx)$"],
    "patterns": ["using\\s+System\\.Web(\\.UI|\\.Mvc|\\.Http|\\.Services)?\\s*;", "HttpContext\\.Current", "<%@\\s*(Page|Control|Master)", ":\\s*System\\.Web\\.UI\\.Page", "\\bViewState\\[", "Server\\.MapPath"],
    "requires": ["target.os not in windows"],
    "advice": "MVC/WebAPI 可迁移到 ASP.NET Core（控制器、过滤器、路由、配置模型需改写）；WebForms 没有官方直接迁移路径，通常按页面重写为 Razor Pages/Blazor/前后端分离，可用 System.Web 适配器（Microsoft.AspNetCore.SystemWebAdapters）分批迁移。",
    "kb": "dotnet.md#web-层",
    "effort": "L"
  },
  {
    "id": "NET-WCF-001",
    "category": "dotnet",
    "title": "WCF 服务端 / .NET Remoting / ASMX",
    "severity": "high",
    "files": ["*.cs", "*.vb", "*.config", "*.svc"],
    "path_patterns": ["\\.(svc|asmx)$"],
    "patterns": ["\\[ServiceContract", "\\[OperationContract", "<system\\.serviceModel>", "System\\.Runtime\\.Remoting", "\\[WebMethod"],
    "requires": ["target.os not in windows"],
    "advice": "服务端可迁 CoreWCF（保留 SOAP 契约，对调用方最友好）或改 gRPC/REST；客户端可用 System.ServiceModel.* NuGet 包。Remoting 无替代，需要改协议。",
    "kb": "dotnet.md#服务通信",
    "effort": "L"
  },
  {
    "id": "NET-WIN-001",
    "category": "dotnet",
    "title": "Windows 专有 API（注册表 / WMI / 事件日志 / Windows 服务 / 性能计数器 / 模拟身份）",
    "severity": "high",
    "files": ["*.cs", "*.vb"],
    "patterns": ["Microsoft\\.Win32\\.Registry", "\\bRegistry\\.(LocalMachine|CurrentUser)", "System\\.Management\\b", "ManagementObjectSearcher", "\\bEventLog\\.", ":\\s*ServiceBase\\b", "PerformanceCounter", "WindowsIdentity", "WindowsImpersonationContext"],
    "requires": ["target.os not in windows"],
    "advice": "注册表→配置文件；WMI/性能计数器→/proc 或 OpenTelemetry 指标；EventLog→ILogger；ServiceBase→Worker Service + systemd（Microsoft.Extensions.Hosting.Systemd）；Windows 身份→LDAP/OAuth。",
    "kb": "dotnet.md#windows-依赖",
    "effort": "M"
  },
  {
    "id": "NET-DRAW-001",
    "category": "dotnet",
    "title": "System.Drawing / GDI+（.NET 6+ 在 Linux 上不再支持）",
    "severity": "high",
    "files": ["*.cs", "*.vb", "*.csproj", "packages.config"],
    "patterns": ["using\\s+System\\.Drawing", "System\\.Drawing\\.(Bitmap|Image|Graphics)", "System\\.Drawing\\.Common"],
    "requires": ["target.os not in windows"],
    "advice": "改为 SkiaSharp 或 ImageSharp（注意 ImageSharp 新版本的许可条款）；验证码、缩略图、二维码、报表导出是常见出现点。SkiaSharp 需要目标架构的 native 资产（arm64 有官方包，LoongArch 需确认）。",
    "kb": "dotnet.md#windows-依赖",
    "effort": "M"
  },
  {
    "id": "NET-COM-001",
    "category": "dotnet",
    "title": "COM 互操作 / Office 自动化 / 水晶报表",
    "severity": "high",
    "files": ["*.cs", "*.vb", "*.csproj", "packages.config"],
    "patterns": ["Microsoft\\.Office\\.Interop", "\\[ComImport", "Type\\.GetTypeFromProgID", "CrystalDecisions", "<COMReference", "Interop\\.\\w+\\.dll"],
    "requires": ["target.os not in windows"],
    "advice": "Office 自动化改为 NPOI / OpenXML SDK（或 WPS 提供的信创 SDK）；水晶报表改为 FastReport/报表服务；其他 COM 组件需要找到 Linux 替代或下沉为独立 Windows 服务（不符合信创时需重写）。",
    "kb": "dotnet.md#windows-依赖",
    "effort": "L"
  },
  {
    "id": "NET-EF-001",
    "category": "dotnet",
    "title": "Entity Framework 6 / EDMX",
    "severity": "medium",
    "files": ["*.cs", "*.vb", "*.config", "*.csproj", "packages.config"],
    "path_patterns": ["\\.edmx$"],
    "patterns": ["using\\s+System\\.Data\\.Entity", "\\bEntityFramework\\b", "<entityFramework", "DbModelBuilder"],
    "requires": ["target.os not in windows"],
    "advice": "EF6.4+ 可以在 .NET 8 上运行，但国产库多只提供 EF Core 提供程序；一般迁到 EF Core 并选用厂商的 EF Core 驱动（版本需与 EF Core 主版本对应）。EDMX 需改为 Code First。",
    "kb": "dotnet.md#数据访问",
    "effort": "M"
  },
  {
    "id": "NET-CFG-001",
    "category": "dotnet",
    "title": "ConfigurationManager / web.config 配置读取",
    "severity": "low",
    "files": ["*.cs", "*.vb"],
    "patterns": ["ConfigurationManager\\.(AppSettings|ConnectionStrings)", "WebConfigurationManager"],
    "requires": ["target.os not in windows"],
    "advice": "迁移到 Microsoft.Extensions.Configuration（appsettings.json + 环境变量）；过渡期可引用 System.Configuration.ConfigurationManager 包。",
    "kb": "dotnet.md#配置与宿主",
    "effort": "S"
  },
  {
    "id": "NET-IIS-001",
    "category": "dotnet",
    "title": "IIS 宿主配置（handlers / modules / rewrite / Windows 认证）",
    "severity": "medium",
    "files": ["*.config"],
    "patterns": ["<system\\.webServer>", "<httpModules>", "<httpHandlers>", "<rewrite>", "<authentication\\s+mode=\"Windows\"", "<identity\\s+impersonate"],
    "requires": ["target.os not in windows"],
    "advice": "改为 Kestrel + Nginx（或信创 Web 服务器）反向代理；HttpModule/Handler 改中间件，URL 重写挪到 Nginx 或 UseRewriter。",
    "kb": "dotnet.md#配置与宿主",
    "effort": "M"
  },
  {
    "id": "NET-BIN-001",
    "category": "dotnet",
    "title": "直接引用的二进制程序集（无源码/非 NuGet），需确认跨平台性",
    "severity": "medium",
    "files": ["*.csproj", "*.vbproj"],
    "patterns": ["<HintPath>[^<]+\\.dll</HintPath>"],
    "requires": ["target.os not in windows"],
    "advice": "逐个列出 HintPath 引用：是否纯托管、是否依赖 Windows API、是否有 netstandard/net8 版本。拿不到新版本的第三方组件是常见阻塞项，尽早找厂商。",
    "kb": "dotnet.md#迁移路线",
    "effort": "M"
  }
]
